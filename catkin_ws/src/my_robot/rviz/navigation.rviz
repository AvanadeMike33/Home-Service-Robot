Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.75
      Color Scheme: map
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.03
      Style: Flat Squares
      Color: 255; 0; 0
      Decay Time: 0
    - Class: rviz/PoseArray
      Name: ParticleCloud
      Enabled: true
      Topic: /particlecloud
    - Class: rviz/Path
      Name: Global Plan
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 255; 0
    - Class: rviz/Path
      Name: Local Plan
      Enabled: true
      Topic: /move_base/TrajectoryPlannerROS/local_plan
      Color: 255; 255; 0
    - Class: rviz/Map
      Name: Local Costmap
      Enabled: false
      Topic: /move_base/local_costmap/costmap
      Alpha: 0.45
      Color Scheme: costmap
    - Class: rviz/Marker
      Name: Home Service Marker
      Enabled: true
      Marker Topic: /visualization_marker
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top Down
      Scale: 60
      Angle: 0
Window Geometry:
  Width: 1200
  Height: 800
