<launch>
  <arg name="world" default="$(find my_robot)/worlds/AvanadeOffice.world"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="use_sim_time" default="true"/>

  <!-- Safe free-space start, aligned with the supplied occupancy map. -->
  <arg name="x" default="-5.0"/>
  <arg name="y" default="-4.0"/>
  <arg name="z" default="0.05"/>
  <arg name="roll" default="0.0"/>
  <arg name="pitch" default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find my_robot)/urdf/my_robot.xacro"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
  </include>

  <!-- Publishes only robot_footprint -> robot links. It does not publish odom. -->
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen"/>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_my_robot"
        output="screen"
        args="-urdf -param robot_description -model my_robot
              -x $(arg x) -y $(arg y) -z $(arg z)
              -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)"/>
</launch>
