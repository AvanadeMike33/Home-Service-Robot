<launch>
  <arg name="map_file" default="$(find my_robot)/maps/map.yaml"/>
  <arg name="initial_pose_x" default="-5.0"/>
  <arg name="initial_pose_y" default="-4.0"/>
  <arg name="initial_pose_a" default="0.0"/>

  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg map_file)" output="screen"/>

  <!-- AMCL is the only owner of map -> odom. -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen" clear_params="true">
    <rosparam command="load" file="$(find my_robot)/config/amcl_params.yaml"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>
    <param name="initial_cov_xx" value="0.10"/>
    <param name="initial_cov_yy" value="0.10"/>
    <param name="initial_cov_aa" value="0.07"/>
  </node>

  <node pkg="move_base" type="move_base" name="move_base"
        output="screen" clear_params="true">
    <rosparam command="load" file="$(find my_robot)/config/move_base_params.yaml"/>

    <rosparam command="load"
              file="$(find my_robot)/config/costmap_common_params.yaml"
              ns="global_costmap"/>
    <rosparam command="load"
              file="$(find my_robot)/config/costmap_common_params.yaml"
              ns="local_costmap"/>

    <rosparam command="load" file="$(find my_robot)/config/global_costmap_params.yaml"/>
    <rosparam command="load" file="$(find my_robot)/config/local_costmap_params.yaml"/>
    <rosparam command="load" file="$(find my_robot)/config/base_local_planner_params.yaml"/>
  </node>
</launch>
