<launch>
  <arg name="rviz" default="true"/>
  <arg name="x" default="-5.0"/>
  <arg name="y" default="-4.0"/>
  <arg name="yaw" default="0.0"/>

  <include file="$(find my_robot)/launch/world.launch">
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <!-- slam_gmapping publishes /map and owns map -> odom during mapping. -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="/scan"/>
    <param name="base_frame" value="robot_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="20.0"/>
    <param name="maxRange" value="30.0"/>
    <param name="particles" value="50"/>
    <param name="linearUpdate" value="0.20"/>
    <param name="angularUpdate" value="0.10"/>
    <param name="temporalUpdate" value="1.0"/>
    <param name="delta" value="0.05"/>
    <param name="xmin" value="-30.0"/>
    <param name="ymin" value="-30.0"/>
    <param name="xmax" value="30.0"/>
    <param name="ymax" value="30.0"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find my_robot)/rviz/mapping.rviz" output="screen"/>
</launch>
