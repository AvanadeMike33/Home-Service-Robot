<launch>
  <arg name="rviz" default="true"/>
  <arg name="map_file" default="$(find my_robot)/maps/map.yaml"/>
  <arg name="x" default="-5.0"/>
  <arg name="y" default="-4.0"/>
  <arg name="yaw" default="0.0"/>

  <include file="$(find my_robot)/launch/world.launch">
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <include file="$(find my_robot)/launch/navigation.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="initial_pose_x" value="$(arg x)"/>
    <arg name="initial_pose_y" value="$(arg y)"/>
    <arg name="initial_pose_a" value="$(arg yaw)"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find my_robot)/rviz/navigation.rviz" output="screen"/>
</launch>
